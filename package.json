{
  "name": "ancientmagic",
  "version": "0.1.0",
  "description": "Arcane spell generator: a static site that writes incantations in ancient scripts such as runes",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests",
    "build": "npm run build:css && npm run build:js && npm run build:html",
    "build:css": "sass --style=compressed --no-source-map src/scss/main.scss pub/css/main.css",
    "build:js": "tsc",
    "build:html": "tsc -p tsconfig.tools.json && node .tools-build/tools/build-pages.js",
    "watch:css": "sass --watch --style=compressed --no-source-map src/scss/main.scss pub/css/main.css",
    "watch:js": "tsc --watch"
  },
  "devDependencies": {
    "sass": "^1.103.1",
    "typescript": "^7.0.2"
  }
}

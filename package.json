{
  "name": "ancientmagic",
  "version": "0.1.0",
  "description": "Arcane spell generator: a static site that writes incantations in ancient scripts such as runes",
  "private": true,
  "license": "Unlicense",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --style=compressed --no-source-map src/scss/main.scss pub/css/main.css",
    "build:js": "tsc",
    "watch:css": "sass --watch --style=compressed --no-source-map src/scss/main.scss pub/css/main.css",
    "watch:js": "tsc --watch"
  },
  "devDependencies": {
    "sass": "^1.103.1",
    "typescript": "^7.0.2"
  }
}
